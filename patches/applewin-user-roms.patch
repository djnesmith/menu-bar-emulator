-        return it->second;
+
+        auto cached = userRomData.find(id);
+        if (cached == userRomData.end())
+        {
+            std::vector<unsigned char> bytes;
+            std::ifstream file(std::filesystem::path(userRomFolder) / rom->second, std::ios::binary);
+            if (file)
+            {
+                bytes.assign(std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>());
